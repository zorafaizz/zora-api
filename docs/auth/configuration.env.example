# Defaults remain disabled. Do not paste secrets into source or chat.
AUTH_ENABLED=false
AUTH_ALLOW_SIGNUP=false
AUTH_ORIGIN=https://api.itsfaiz.my.id
AUTH_CODE_HMAC_KEY=
AUTH_CSRF_KEY=
AUTH_LIMIT_KEY=
# Implement/configure an approved real adapter before production activation.
AUTH_MAIL_TRANSPORT=disabled
# Explicit development/test loopback HTTP only; prohibited in production.
AUTH_ALLOW_INSECURE_LOCAL=false
# Exact trusted proxy IPs, never a wildcard. Inspect real ingress first.
AUTH_TRUSTED_PROXY_IPS=
# Operator-classified service/shared identities; comma-separated UUIDs.
AUTH_SERVICE_ACCOUNT_IDS=
